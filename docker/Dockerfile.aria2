# PocketDrive 自维护的原版 aria2 sidecar。
#
# 不使用第三方 aria2 魔改镜像：二进制直接来自 Alpine 当前稳定版的官方
# community 仓库。GitHub Actions 每周无缓存重建并跑 RPC + 实际下载冒烟
# 测试；Alpine 换代、基础包和 aria2 有安全/修订更新时会自动进入 latest。
FROM alpine:latest

ARG BUILD_REFRESH=manual

LABEL org.opencontainers.image.title="PocketDrive aria2" \
      org.opencontainers.image.description="Upstream aria2 packaged by Alpine for PocketDrive" \
      org.opencontainers.image.source="https://github.com/lqlcj/PocketDrive"

RUN echo "build-refresh=${BUILD_REFRESH}" >/dev/null \
    && apk upgrade --no-cache \
    && apk add --no-cache aria2 ca-certificates tzdata curl jq \
    && aria2c --version

COPY docker/aria2-entrypoint.sh /usr/local/bin/aria2-entrypoint
COPY docker/aria2-healthcheck.sh /usr/local/bin/aria2-healthcheck
RUN chmod 0755 /usr/local/bin/aria2-entrypoint /usr/local/bin/aria2-healthcheck

ENV RPC_PORT=6800 \
    LISTEN_PORT=6888 \
    MAX_CONCURRENT_DOWNLOADS=3 \
    BT_MAX_PEERS=55 \
    DISK_CACHE=64M \
    ENABLE_DHT6=false \
    UMASK_SET=022 \
    ARIA2_CONFIG_DIR=/config \
    ARIA2_DATA_DIR=/data

VOLUME ["/data", "/config"]
EXPOSE 6800/tcp 6888/tcp 6888/udp

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD ["/usr/local/bin/aria2-healthcheck"]

WORKDIR /data
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/aria2-entrypoint"]
